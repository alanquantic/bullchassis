# Secreto para firmar el token de tiempo del formulario (HMAC). 32+ bytes
# aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si queda vacío, la capa 2 se degrada (deja pasar) sin romper el formulario.
FORM_SECRET=

# Resend — envío del correo de contacto.
RESEND_API_KEY=
# Remitente verificado en Resend. Por defecto: "Bull Chassis <onboarding@resend.dev>"
RESEND_FROM_EMAIL=
# Destinatarios separados por coma. Por defecto: sales@bullchassis.com
RESEND_TO_EMAIL=
